# MongoDB connection string (Atlas or local)
MONGO_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/Medtech?retryWrites=true&w=majority

# JWT signing secret. Generate with: openssl rand -hex 64
JWT_SECRET=replace_me_with_a_long_random_string

# Groq AI configuration
GROQ_API_KEY=gsk_your_groq_key_here
MEDISHIELD_LLM_PROVIDER=groq
MEDISHIELD_ANALYST_MODEL=llama-3.3-70b-versatile

# HTTP listen port (Render injects this; locally defaults to 5000)
PORT=5000

# CORS — comma-separated list of allowed frontend origins.
# *.vercel.app domains and localhost are always allowed.
# Use "*" to allow everything (demos only).
CORS_ORIGINS=https://your-frontend.vercel.app

# Convenience single-origin alias (same effect as adding to CORS_ORIGINS)
FRONTEND_URL=https://your-frontend.vercel.app
