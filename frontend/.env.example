# URL of the API server.
#
# Production (Vercel): set this to your Render backend URL, e.g.
#   VITE_API_URL=https://medishield-api.onrender.com
#
# Local development: point at your local Express server
#   VITE_API_URL=http://localhost:5000
#
# Leave empty to call the same origin (only useful if you reverse-proxy
# the API on the same domain).

VITE_API_URL=
